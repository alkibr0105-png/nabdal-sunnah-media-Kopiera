# Kopiera till config.env och fyll i själv. Dela aldrig config.env med någon.

# Instagram (Business- eller Creator-konto)
# Lämna GRAPH_HOST tom = väljs automatiskt (IG…-token → graph.instagram.com, EAA… → graph.facebook.com)
GRAPH_HOST=
GRAPH_VERSION=v23.0
IG_USER_ID=
IG_ACCESS_TOKEN=

# Publik plats för bilden (Instagram hämtar bilden från en publik URL)
# Skapa ett PUBLIKT GitHub-repo, t.ex. "dittnamn/nabd-images",
# och en fine-grained token med "Contents: Read and write" endast för det repot.
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
